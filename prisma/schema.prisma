// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ==========================================
// 1. SYSTEM & CONFIGURATION ENTS
// ==========================================

model SystemConfig {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique @db.VarChar(100)
  value       String   @db.Text
  description String?  @db.Text
  updated_at  DateTime @updatedAt @map("updated_at")
  updated_by  String?  @db.Uuid @map("updated_by")

  @@map("system_configs")
}

model NumberSequence {
  prefix      String   @id @db.VarChar(20)
  next_val    Int      @default(1) @map("next_val")
  description String?  @db.Text
  updated_at  DateTime @updatedAt @map("updated_at")

  @@map("number_sequences")
}

model TariffReference {
  id              String      @id @default(uuid()) @db.Uuid
  origin_city     String      @db.VarChar(100) @map("origin_city")
  dest_city       String      @db.VarChar(100) @map("dest_city")
  pricing_type_id String      @db.Uuid @map("pricing_type_id")
  pricing_type    PricingType @relation(fields: [pricing_type_id], references: [id], onDelete: Restrict)
  item_type       String      @db.VarChar(100) @map("item_type")
  rate_per_kg     Decimal     @db.Decimal(12, 2) @map("rate_per_kg")
  rate_per_cbm    Decimal     @db.Decimal(12, 2) @map("rate_per_cbm")
  min_weight      Decimal     @default(1.00) @db.Decimal(10, 2) @map("min_weight")
  min_volume      Decimal     @default(1.00) @db.Decimal(10, 2) @map("min_volume")
  min_fee         Decimal     @default(0.00) @db.Decimal(12, 2) @map("min_fee")
  is_active       Boolean     @default(true) @map("is_active")
  created_at      DateTime    @default(now()) @map("created_at")
  updated_at      DateTime    @updatedAt @map("updated_at")

  @@map("tariff_references")
}

// ==========================================
// 2. MASTER DATA ENTS
// ==========================================

model Warehouse {
  id         String   @id @default(uuid()) @db.Uuid
  code       String   @unique @db.VarChar(20)
  name       String   @db.VarChar(100)
  address    String   @db.Text
  city       String   @db.VarChar(100)
  is_active  Boolean  @default(true) @map("is_active")
  created_at DateTime @default(now()) @map("created_at")
  updated_at DateTime @updatedAt @map("updated_at")

  userWarehouses  UserWarehouse[]
  originShipments Shipment[]      @relation("ShipmentOrigin")
  destShipments   Shipment[]      @relation("ShipmentDest")
  warehouseMoves  WarehouseMovement[]
  scanLogs        ScanLog[]

  @@map("warehouses")
}

model Customer {
  id         String         @id @default(uuid()) @db.Uuid
  name       String         @db.VarChar(150)
  phone      String         @db.VarChar(50)
  address    String         @db.Text
  email      String?        @db.VarChar(100)
  status     CustomerStatus @default(ACTIVE)
  created_at DateTime       @default(now()) @map("created_at")
  updated_at DateTime       @updatedAt @map("updated_at")

  sentShipments     Shipment[] @relation("ShipmentSender")
  receivedShipments Shipment[] @relation("ShipmentReceiver")

  @@map("customers")
}

model Vehicle {
  id                 String         @id @default(uuid()) @db.Uuid
  vehicle_code       String         @unique @db.VarChar(30) @map("vehicle_code")
  plate_number       String         @unique @db.VarChar(30) @map("plate_number")
  vehicle_type       String         @db.VarChar(50) @map("vehicle_type")
  capacity_weight    Decimal        @db.Decimal(10, 2) @map("capacity_weight")
  capacity_volume    Decimal        @db.Decimal(10, 2) @map("capacity_volume")
  operational_status VehicleStatus  @default(ACTIVE) @map("operational_status")
  created_at         DateTime       @default(now()) @map("created_at")
  updated_at         DateTime       @updatedAt @map("updated_at")

  trips Trip[]

  @@map("vehicles")
}

model Driver {
  id             String   @id @default(uuid()) @db.Uuid
  driver_code    String   @unique @db.VarChar(30) @map("driver_code")
  name           String   @db.VarChar(150)
  phone          String   @db.VarChar(50)
  license_number String   @unique @db.VarChar(50) @map("license_number")
  is_active      Boolean  @default(true) @map("is_active")
  user_id        String?  @unique @db.Uuid @map("user_id")
  user           User?    @relation(fields: [user_id], references: [id], onDelete: SetNull)
  created_at     DateTime @default(now()) @map("created_at")
  updated_at     DateTime @updatedAt @map("updated_at")

  trips Trip[]

  @@map("drivers")
}

model PricingType {
  id         String   @id @default(uuid()) @db.Uuid
  code       String   @unique @db.VarChar(30)
  name       String   @db.VarChar(100)
  is_active  Boolean  @default(true) @map("is_active")
  created_at DateTime @default(now()) @map("created_at")
  updated_at DateTime @updatedAt @map("updated_at")

  shipments        Shipment[]
  tariffReferences TariffReference[]

  @@map("pricing_types")
}

// ==========================================
// 3. RBAC ENTS
// ==========================================

model User {
  id            String          @id @default(uuid()) @db.Uuid
  username      String          @unique @db.VarChar(50)
  password_hash String          @db.VarChar(255) @map("password_hash")
  full_name     String          @db.VarChar(150) @map("full_name")
  email         String?         @unique @db.VarChar(100)
  phone         String?         @db.VarChar(50)
  is_active     Boolean         @default(true) @map("is_active")
  created_at    DateTime        @default(now()) @map("created_at")
  updated_at    DateTime        @updatedAt @map("updated_at")

  driver         Driver?
  userRoles      UserRole[]
  userWarehouses UserWarehouse[]
  auditLogs      AuditLog[]

  @@map("users")
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique @db.VarChar(50)
  description String?  @db.Text
  created_at  DateTime @default(now()) @map("created_at")
  updated_at  DateTime @updatedAt @map("updated_at")

  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique @db.VarChar(100)
  name        String   @db.VarChar(100)
  description String?  @db.Text
  created_at  DateTime @default(now()) @map("created_at")
  updated_at  DateTime @updatedAt @map("updated_at")

  rolePermissions RolePermission[]

  @@map("permissions")
}

model UserRole {
  user_id String @db.Uuid @map("user_id")
  role_id String @db.Uuid @map("role_id")
  user    User   @relation(fields: [user_id], references: [id], onDelete: Cascade)
  role    Role   @relation(fields: [role_id], references: [id], onDelete: Cascade)

  @@id([user_id, role_id])
  @@map("user_roles")
}

model RolePermission {
  role_id       String     @db.Uuid @map("role_id")
  permission_id String     @db.Uuid @map("permission_id")
  role          Role       @relation(fields: [role_id], references: [id], onDelete: Cascade)
  permission    Permission @relation(fields: [permission_id], references: [id], onDelete: Cascade)

  @@id([role_id, permission_id])
  @@map("role_permissions")
}

model UserWarehouse {
  user_id      String    @db.Uuid @map("user_id")
  warehouse_id String    @db.Uuid @map("warehouse_id")
  user         User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  warehouse    Warehouse @relation(fields: [warehouse_id], references: [id], onDelete: Cascade)

  @@id([user_id, warehouse_id])
  @@map("user_warehouses")
}

// ==========================================
// 4. TRANSACTIONAL ENTS (SHIPMENT & KOLI)
// ==========================================

model Shipment {
  id                 String           @id @default(uuid()) @db.Uuid
  shipment_no        String           @unique @db.VarChar(50) @map("shipment_no")
  barcode            String           @unique @db.VarChar(100)
  status             ShipmentStatus   @default(DRAFT)
  origin_warehouse_id String          @db.Uuid @map("origin_warehouse_id")
  originWarehouse    Warehouse        @relation("ShipmentOrigin", fields: [origin_warehouse_id], references: [id], onDelete: Restrict)
  dest_warehouse_id  String           @db.Uuid @map("dest_warehouse_id")
  destWarehouse      Warehouse        @relation("ShipmentDest", fields: [dest_warehouse_id], references: [id], onDelete: Restrict)
  
  sender_id          String           @db.Uuid @map("sender_id")
  sender             Customer         @relation("ShipmentSender", fields: [sender_id], references: [id], onDelete: Restrict)
  receiver_id        String           @db.Uuid @map("receiver_id")
  receiver           Customer         @relation("ShipmentReceiver", fields: [receiver_id], references: [id], onDelete: Restrict)
  
  goods_description  String           @db.Text @map("goods_description")
  weight             Decimal          @db.Decimal(10, 2)
  volume             Decimal          @db.Decimal(10, 2)
  qty                Int              @default(1)
  
  pricing_type_id    String           @db.Uuid @map("pricing_type_id")
  pricingType        PricingType      @relation(fields: [pricing_type_id], references: [id], onDelete: Restrict)
  price_name_snap    String           @db.VarChar(100) @map("price_name_snap")
  price_nominal_snap Decimal          @db.Decimal(12, 2) @map("price_nominal_snap")
  manual_price       Decimal          @db.Decimal(12, 2) @map("manual_price")
  
  reference_shipment_id String?       @db.Uuid @map("reference_shipment_id")
  referenceShipment     Shipment?     @relation("ShipmentReturnRef", fields: [reference_shipment_id], references: [id], onDelete: SetNull)
  returnShipments       Shipment[]    @relation("ShipmentReturnRef")

  created_at         DateTime         @default(now()) @map("created_at")
  updated_at         DateTime         @updatedAt @map("updated_at")

  koliItems          KoliItem[]
  manifestItems      ManifestItem[]
  trackingEvents     TrackingEvent[]
  warehouseMoves     WarehouseMovement[]
  scanLogs           ScanLog[]
  deliveryProofItems DeliveryProofItem[]
  financeRecords     FinanceRecord[]

  @@map("shipments")
}

model Koli {
  id         String     @id @default(uuid()) @db.Uuid
  koli_no    String     @unique @db.VarChar(50) @map("koli_no")
  barcode    String     @unique @db.VarChar(100)
  status     KoliStatus @default(PACKED)
  created_at DateTime   @default(now()) @map("created_at")
  updated_at DateTime   @updatedAt @map("updated_at")

  koliItems KoliItem[]
  scanLogs  ScanLog[]

  @@map("kolis")
}

model KoliItem {
  id           String    @id @default(uuid()) @db.Uuid
  koli_id      String    @db.Uuid @map("koli_id")
  koli         Koli      @relation(fields: [koli_id], references: [id], onDelete: Restrict)
  shipment_id  String    @db.Uuid @map("shipment_id")
  shipment     Shipment  @relation(fields: [shipment_id], references: [id], onDelete: Restrict)
  assigned_at  DateTime  @default(now()) @map("assigned_at")
  released_at  DateTime? @map("released_at")

  @@map("koli_items")
}


// ==========================================
// 5. TRIP & MANIFEST ENTS
// ==========================================

model Trip {
  id                String       @id @default(uuid()) @db.Uuid
  trip_code         String       @unique @db.VarChar(50) @map("trip_code")
  status            TripStatus   @default(DRAFT)
  vehicle_id        String       @db.Uuid @map("vehicle_id")
  vehicle           Vehicle      @relation(fields: [vehicle_id], references: [id], onDelete: Restrict)
  primary_driver_id String       @db.Uuid @map("primary_driver_id")
  primaryDriver     Driver       @relation(fields: [primary_driver_id], references: [id], onDelete: Restrict)
  departure_time    DateTime?    @map("departure_time")
  arrival_time      DateTime?    @map("arrival_time")
  created_at        DateTime     @default(now()) @map("created_at")
  updated_at        DateTime     @updatedAt @map("updated_at")

  manifest          Manifest?
  tripExpenses      TripExpense[]

  @@map("trips")
}

model Manifest {
  id           String           @id @default(uuid()) @db.Uuid
  manifest_no  String           @unique @db.VarChar(50) @map("manifest_no")
  trip_id      String           @unique @db.Uuid @map("trip_id")
  trip         Trip             @relation(fields: [trip_id], references: [id], onDelete: Restrict)
  status       ManifestStatus   @default(DRAFT)
  created_at   DateTime         @default(now()) @map("created_at")
  updated_at   DateTime         @updatedAt @map("updated_at")

  manifestItems  ManifestItem[]
  manifestEvents ManifestEvent[]

  @@map("manifests")
}

model ManifestItem {
  id           String     @id @default(uuid()) @db.Uuid
  manifest_id  String     @db.Uuid @map("manifest_id")
  manifest     Manifest   @relation(fields: [manifest_id], references: [id], onDelete: Restrict)
  shipment_id  String     @db.Uuid @map("shipment_id")
  shipment     Shipment   @relation(fields: [shipment_id], references: [id], onDelete: Restrict)
  assigned_at  DateTime   @default(now()) @map("assigned_at")
  released_at  DateTime?  @map("released_at")

  @@map("manifest_items")
}




// ==========================================
// 6. TRACKING, WAREHOUSE & DELIVERY ENTS
// ==========================================

model ManifestEvent {
  id              String         @id @default(uuid()) @db.Uuid
  manifest_id     String         @db.Uuid @map("manifest_id")
  manifest        Manifest       @relation(fields: [manifest_id], references: [id], onDelete: Restrict)
  event_type      String         @db.VarChar(100) @map("event_type")
  description     String?        @db.Text
  location_name   String?        @db.VarChar(150) @map("location_name")
  photo_url       String?        @db.Text @map("photo_url")
  metadata_before Json?          @map("metadata_before")
  metadata_after  Json?          @map("metadata_after")
  created_at      DateTime       @default(now()) @map("created_at")

  trackingEvents  TrackingEvent[]

  @@map("manifest_events")
}

model TrackingEvent {
  id                        String         @id @default(uuid()) @db.Uuid
  shipment_id               String         @db.Uuid @map("shipment_id")
  shipment                  Shipment       @relation(fields: [shipment_id], references: [id], onDelete: Restrict)
  source_manifest_event_id  String?        @db.Uuid @map("source_manifest_event_id")
  sourceManifestEvent       ManifestEvent? @relation(fields: [source_manifest_event_id], references: [id], onDelete: SetNull)
  status                    ShipmentStatus
  description               String         @db.Text
  location                  String?        @db.VarChar(150)
  created_at                DateTime       @default(now()) @map("created_at")

  @@map("tracking_events")
}

model WarehouseMovement {
  id           String    @id @default(uuid()) @db.Uuid
  warehouse_id String    @db.Uuid @map("warehouse_id")
  warehouse    Warehouse @relation(fields: [warehouse_id], references: [id], onDelete: Restrict)
  shipment_id  String    @db.Uuid @map("shipment_id")
  shipment     Shipment  @relation(fields: [shipment_id], references: [id], onDelete: Restrict)
  movement_type String   @db.VarChar(50) @map("movement_type")
  actor_id     String?   @db.Uuid @map("actor_id")
  notes        String?   @db.Text
  created_at   DateTime  @default(now()) @map("created_at")

  @@map("warehouse_movements")
}

model ScanLog {
  id           String     @id @default(uuid()) @db.Uuid
  warehouse_id String     @db.Uuid @map("warehouse_id")
  warehouse    Warehouse  @relation(fields: [warehouse_id], references: [id], onDelete: Restrict)
  shipment_id  String?    @db.Uuid @map("shipment_id")
  shipment     Shipment?  @relation(fields: [shipment_id], references: [id], onDelete: SetNull)
  koli_id      String?    @db.Uuid @map("koli_id")
  koli         Koli?      @relation(fields: [koli_id], references: [id], onDelete: SetNull)
  scan_result  String     @db.VarChar(50) @map("scan_result")
  scanned_by   String?    @db.Uuid @map("scanned_by")
  error_message String?   @db.Text @map("error_message")
  created_at   DateTime   @default(now()) @map("created_at")

  @@map("scan_logs")
}


model DeliveryProof {
  id             String              @id @default(uuid()) @db.Uuid
  proof_number   String              @unique @db.VarChar(50) @map("proof_number")
  proof_type     String              @db.VarChar(50) @map("proof_type")
  recipient_name String              @db.VarChar(150) @map("recipient_name")
  recipient_phone String             @db.VarChar(50) @map("recipient_phone")
  signed_at      DateTime            @default(now()) @map("signed_at")
  actor_id       String?             @db.Uuid @map("actor_id")
  photo_url      String?             @db.Text @map("photo_url")
  signature_url  String?             @db.Text @map("signature_url")
  notes          String?             @db.Text
  created_at     DateTime            @default(now()) @map("created_at")
  updated_at     DateTime            @updatedAt @map("updated_at")

  deliveryProofItems DeliveryProofItem[]

  @@map("delivery_proofs")
}

model DeliveryProofItem {
  id                String        @id @default(uuid()) @db.Uuid
  delivery_proof_id String        @db.Uuid @map("delivery_proof_id")
  deliveryProof     DeliveryProof @relation(fields: [delivery_proof_id], references: [id], onDelete: Restrict)
  shipment_id       String        @db.Uuid @map("shipment_id")
  shipment          Shipment      @relation(fields: [shipment_id], references: [id], onDelete: Restrict)
  created_at        DateTime      @default(now()) @map("created_at")

  @@map("delivery_proof_items")
}


// ==========================================
// 7. FINANCE & AUDIT ENTS
// ==========================================

model FinanceRecord {
  id                  String         @id @default(uuid()) @db.Uuid
  shipment_id         String         @db.Uuid @map("shipment_id")
  shipment            Shipment       @relation(fields: [shipment_id], references: [id], onDelete: Restrict)
  record_type         String         @db.VarChar(50) @map("record_type")
  amount              Decimal        @db.Decimal(12, 2)
  approval_status     ApprovalStatus @default(PENDING) @map("approval_status")
  approved_by         String?        @db.Uuid @map("approved_by")
  approved_at         DateTime?      @map("approved_at")
  reverses_record_id  String?        @db.Uuid @map("reverses_record_id")
  reversesRecord      FinanceRecord? @relation("FinanceReversal", fields: [reverses_record_id], references: [id], onDelete: Restrict)
  reversedBy          FinanceRecord[] @relation("FinanceReversal")
  notes               String?        @db.Text
  created_at          DateTime       @default(now()) @map("created_at")
  updated_at          DateTime       @updatedAt @map("updated_at")

  @@map("finance_records")
}

model TripExpense {
  id              String         @id @default(uuid()) @db.Uuid
  trip_id         String         @db.Uuid @map("trip_id")
  trip            Trip           @relation(fields: [trip_id], references: [id], onDelete: Restrict)
  amount          Decimal        @db.Decimal(12, 2)
  status          String         @db.VarChar(50) @default("ACTIVE")
  approval_status ApprovalStatus @default(PENDING) @map("approval_status")
  approved_by     String?        @db.Uuid @map("approved_by")
  approved_at     DateTime?      @map("approved_at")
  revised_from_id String?        @db.Uuid @map("revised_from_id")
  revisedFrom     TripExpense?   @relation("ExpenseRevision", fields: [revised_from_id], references: [id], onDelete: Restrict)
  revisions       TripExpense[]  @relation("ExpenseRevision")
  notes           String?        @db.Text
  created_at      DateTime       @default(now()) @map("created_at")
  updated_at      DateTime       @updatedAt @map("updated_at")

  @@map("trip_expenses")
}

model AuditLog {
  id           String   @id @default(uuid()) @db.Uuid
  user_id      String?  @db.Uuid @map("user_id")
  user         User?    @relation(fields: [user_id], references: [id], onDelete: SetNull)
  action       String   @db.VarChar(100)
  entity_name  String   @db.VarChar(100) @map("entity_name")
  entity_id    String?  @db.Uuid @map("entity_id")
  old_values   Json?    @map("old_values")
  new_values   Json?    @map("new_values")
  ip_address   String?  @db.VarChar(50) @map("ip_address")
  created_at   DateTime @default(now()) @map("created_at")

  @@map("audit_logs")
}


// ==========================================
// 8. ENUMS
// ==========================================

enum CustomerStatus {
  ACTIVE
  INACTIVE
  BLACKLISTED
}

enum VehicleStatus {
  ACTIVE
  MAINTENANCE
  INACTIVE
}

enum ShipmentStatus {
  DRAFT
  BOOKED
  RECEIVED_AT_ORIGIN
  MANIFESTED
  IN_TRANSIT
  ARRIVED_AT_DESTINATION
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  RETURNED
}

enum KoliStatus {
  PACKED
  MANIFESTED
  IN_TRANSIT
  RECEIVED
  UNPACKED
}

enum TripStatus {
  DRAFT
  LOADING
  READY_TO_DEPART
  DEPARTED
  ARRIVED
  CLOSED
  CANCELLED
}

enum ManifestStatus {
  DRAFT
  LOCKED
  DEPARTED
  ARRIVED
  CLOSED
  CANCELLED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

